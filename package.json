{
  "name": "webcodex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src tests prisma docs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:e2e": "playwright test",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:backup": "node scripts/local-db.mjs backup",
    "db:seed:admin": "tsx --env-file=.env prisma/seed-admin.ts",
    "db:generate:postgresql": "prisma generate --schema prisma/postgresql/schema.prisma",
    "db:transfer": "node scripts/transfer-db.mjs",
    "postinstall": "prisma generate",
    "db:add:cybersecurity": "node --env-file=.env scripts/add-cybersecurity.mjs",
    "db:areas": "tsx --env-file=.env scripts/consolidate-areas.ts",
    "production:prepare": "node --env-file=.env scripts/prepare-production.mjs",
    "security:check": "pnpm audit --prod && vitest run tests/security.test.ts tests/security-routes.test.ts tests/private-media-security.test.ts tests/recovery-security.test.ts tests/permissions.test.ts tests/crypto.test.ts tests/content-rules.test.ts tests/project-seo.test.ts tests/proforma.test.ts",
    "security:maintenance": "node --env-file=.env scripts/security-maintenance.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@hookform/resolvers": "^5.9.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "6.19.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.25.0",
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  }
}
